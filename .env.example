# LOCAL REVIEW ONLY. Do not copy these local/false values into Cloudflare Production.
# Production public defaults, including the approved widget key, are in wrangler.toml.
# npm run build explicitly passes those defaults to Astro on Cloudflare main.
# Existing build overrides are preserved and validated. Keep private keys in Cloudflare.
# Cloudflare main defaults to production; other branches stay preview.
# For production, omit PUBLIC_FORM_ENABLED or set true, and use the real public site key.
# Cloudflare main rejects local/false overrides instead of publishing disabled fields.
PUBLIC_DEPLOYMENT_ENV=local
PUBLIC_SITE_URL=
PUBLIC_ALLOW_INDEXING=false
PUBLIC_BUSINESS_PHONE=303-513-4389
PUBLIC_BUSINESS_EMAIL=
PUBLIC_FORM_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=
# Server-only Cloudflare Pages environment variables (never prefix these with PUBLIC_).
# wrangler.toml enables production inquiries and supplies SITE_ORIGIN; preview stays disabled.
# These false/blank examples are for local review, not production overrides.
INQUIRIES_ENABLED=false
SITE_ORIGIN=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
INQUIRY_FROM=
INQUIRY_TO=
