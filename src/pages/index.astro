---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Mark from '../components/Mark.astro';
import Closing from '../components/Closing.astro';
import Evidence from '../components/Evidence.astro';
import CommercialOnly from '../components/CommercialOnly.astro';
import { Image } from 'astro:assets';
import interior from '../assets/workplace.png';
import landscape from '../assets/foothills.png';
const benefits = [
  ['01', 'One point of contact.', 'Talk directly with the owner about your space, your priorities, and any changes along the way.'],
  ['02', 'A scope in writing.', 'Know which tasks are included and how often they happen, with a checklist agreed before service begins.'],
  ['03', 'A schedule that fits.', 'Plan recurring visits around your workplace. Evening or early-morning options can be discussed, subject to availability.'],
];
const spaces = [
  ['Offices & professional workspaces', 'A considered clean for deskside floors, meeting rooms, reception areas, and shared spaces.'],
  ['Retail shops & showrooms', 'Care for the entrances, floors, and agreed surfaces that welcome your customers.'],
  ['Studios & community spaces', 'Routine cleaning for the rooms where people gather, work, and create.'],
  ['Commercial common areas', 'Attention to shared entrances, corridors, restrooms, and everyday touch points.'],
];
const included = ['Accessible floor vacuuming & mopping', 'Restroom cleaning', 'Trash & recycling to the agreed collection point', 'Break-room surfaces & sinks', 'Agreed counters & accessible touch points', 'Entrance glass & routine spot cleaning'];
const faqs = [
  ['Do you clean after business hours?', 'Evening and early-morning visits can be discussed during the walkthrough. We’ll agree on a schedule that works for the space, subject to availability.'],
  ['How often can you clean?', 'Recurring service generally runs one to three visits per week. We’ll discuss how your workplace is used and agree on a practical frequency during the walkthrough, subject to availability.'],
  ['How do you determine the price?', 'Pricing is per visit, based on the walkthrough, cleanable square footage, frequency, current condition, and agreed scope. You receive a written scope and quote before work begins. Initial resets or specialist work need a separate scope where appropriate.'],
  ['What happens during the walkthrough?', 'We look at the areas you want cleaned, talk through priorities and access, and outline a practical checklist. Submitting a request starts a conversation; it does not confirm an appointment.'],
  ['Are supplies included?', 'Supplies and equipment are discussed as part of your proposal. Restocking can be included by agreement, with responsibility for paper products and other consumables clearly defined.'],
  ['Can we discuss keys and building access?', 'Yes. Access arrangements are agreed directly before service begins. Please don’t send keys, alarm codes, or other sensitive building details through the website form.'],
];
---
<Layout title="Commercial Cleaning in Bailey, Conifer & Evergreen | Fenrir Commercial Cleaning Service">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span> Owner-operated. Locally rooted.</p><h1 id="hero-title">A cleaner workplace.<br/><em>A little more<br class="wide-break"/> peace of mind.</em></h1><p class="hero-summary">Commercial cleaning for Colorado’s mountain communities.</p><p class="hero-description">Recurring cleaning for local offices, retail shops, and similar commercial spaces, generally one to three visits per week. Work directly with the owner, with a written scope and quote before work begins.</p><CommercialOnly/><div class="hero-actions"><a class="button" href="/request-walkthrough">Request a Walkthrough <Arrow/></a><a class="text-link" href="#included">See What’s Included <span aria-hidden="true">↗</span></a></div><div class="hero-towns"><svg width="16" height="20" viewBox="0 0 16 20" fill="none" aria-hidden="true"><path d="M14 7c0 5-6 11-6 11S2 12 2 7a6 6 0 1 1 12 0Z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="7" r="2" stroke="currentColor" stroke-width="1.4"/></svg><span>Bailey <span class="town-dot">·</span> Conifer <span class="town-dot">·</span> Evergreen</span></div></div>
    <figure class="hero-visual"><div class="hero-photo"><Image src={interior} alt="Sunlit office reception with oak counters, tidy floors, and comfortable visitor seating." widths={[480, 800, 1200, 1536]} sizes="(max-width: 760px) 100vw, 50vw" width={768} height={820} fit="cover" loading="eager" fetchpriority="high" format="webp"/><div class="image-seal" aria-hidden="true"><Mark/><span>Care in<br/>every detail.</span></div></div><figcaption>Well-kept spaces. A welcoming start to the workday.<span>Illustrative interior</span></figcaption></figure>
  </section>
  <div class="promise-strip"><div class="container"><span>Commercial spaces. Thoughtful care.</span><span>Written cleaning scope</span><span>Agreed recurring schedule</span><span>Direct owner communication</span></div></div>

  <section id="approach" class="section approach container" aria-labelledby="approach-title"><div class="section-intro"><p class="eyebrow">A straightforward approach</p><h2 id="approach-title">Good work starts<br/>with clear expectations.</h2><p>You have a business to run. Your cleaning should be one less thing to piece together.</p></div><div class="approach-list">{benefits.map(([number,title,copy]) => <article><span class="index-number">{number}</span><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div></section>

  <section id="services" class="services-section section" aria-labelledby="services-title"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">The places we care for</p><h2 id="services-title">Made for your workday.</h2></div><p>From a quiet office to a busy storefront,<br class="desktop-break"/> a clean space makes room for the work ahead.</p></div><div class="spaces-list">{spaces.map(([title,copy], i) => <article><div class="space-icon" aria-hidden="true">{i === 0 ? <svg viewBox="0 0 40 40" fill="none"><path d="M8 33V8h24v25M4 33h32M14 14h4m5 0h3m-12 7h4m5 0h3m-12 7h4m5 0h3"/></svg> : i === 1 ? <svg viewBox="0 0 40 40" fill="none"><path d="M7 17v16h26V17M5 17l4-9h22l4 9M5 17c0 6 8 6 8 0 0 6 7 6 7 0 0 6 7 6 7 0 0 6 8 6 8 0M14 33v-9h12v9"/></svg> : i === 2 ? <svg viewBox="0 0 40 40" fill="none"><path d="M5 33h30M8 33V17l12-9 12 9v16M15 33V22h10v11M16 15h8"/></svg> : <svg viewBox="0 0 40 40" fill="none"><path d="M7 33V8h26v25M3 33h34M14 33V15h12v18M14 25h12M20 15v18"/></svg>}</div><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

  <section id="included" class="section included-section container" aria-labelledby="included-title"><div class="scope-note"><p class="eyebrow">What’s included</p><h2 id="included-title">The everyday details.<br/><em>Handled with care.</em></h2><p>A practical foundation for routine commercial cleaning. We tailor the final checklist to your space during the walkthrough.</p><a class="text-link" href="/request-walkthrough">Talk through your scope <Arrow/></a></div><div class="checklist"><ul>{included.map(item => <li><span class="check" aria-hidden="true">✓</span>{item}</li>)}</ul><p class="scope-footnote">Restocking can be included when agreed. Initial resets and specialist work receive a separate scope where needed.</p></div></section>

  <section class="how-section section" aria-labelledby="how-title"><div class="container"><div class="how-heading"><p class="eyebrow">From first conversation to a clear plan</p><h2 id="how-title">A simple way to get started.</h2></div><ol class="steps"><li><span>01</span><h3>Tell us about<br/>your workplace.</h3><p>Share a few details about your space and the cleaning you have in mind.</p></li><li><span>02</span><h3>Walk through<br/>the space together.</h3><p>Discuss the rooms, priorities, frequency, and practical access arrangements.</p></li><li><span>03</span><h3>Agree on<br/>a written plan.</h3><p>Review your cleaning proposal and agree on the scope and schedule before service begins.</p></li></ol><p class="how-note">A walkthrough request is an inquiry. We’ll arrange a time together.</p></div></section>

  <section class="section owner-section container" aria-labelledby="owner-title"><figure class="landscape-figure"><Image src={landscape} alt="Ponderosa pines and weathered granite in gently rolling Colorado-style foothills." widths={[480,800,1200]} sizes="(max-width: 760px) 100vw, 45vw" width={640} height={620} fit="cover" format="webp"/><figcaption>Inspired by the foothills we call home. Illustrative landscape.</figcaption></figure><div class="owner-copy"><p class="eyebrow">Your local point of contact</p><h2 id="owner-title">A familiar face.<br/>A thoughtful approach.</h2><p class="owner-lead">“I’m Blake Bannon, the owner of Fenrir Commercial Cleaning Service, based right here in Bailey.”</p><p>I believe caring for a workplace starts with listening. We’ll talk about what matters in your space, put the plan in writing, and keep communication direct.</p><div class="owner-signature"><span>Blake Bannon</span><small>Owner · Bailey, Colorado</small></div><a class="text-link" href="/about">A little more about Fenrir <Arrow/></a></div></section>
  <Evidence/>

  <section id="service-area" class="area-section section" aria-labelledby="area-title"><div class="container area-inner"><div><p class="eyebrow">Close to home</p><h2 id="area-title">Here in the foothills.<br/>Here for your workplace.</h2><p>Based in Bailey, serving commercial spaces in three neighboring mountain communities.</p></div><div class="town-list" aria-label="Core service towns"><span>Bailey<small>Colorado</small></span><span>Conifer<small>Colorado</small></span><span>Evergreen<small>Colorado</small></span></div></div><svg class="area-ridge" viewBox="0 0 1440 130" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="m0 118 180-47 132 26 170-68 110 28 137-47 149 65 124-38 150 61 133-28 155 44" stroke="currentColor"/><path d="m0 130 180-37 132 24 170-67 110 27 137-48 149 66 124-38 150 61 133-28 155 44" stroke="currentColor"/></svg></section>

  <section class="section faq-section container" aria-labelledby="faq-title"><div><p class="eyebrow">A few helpful details</p><h2 id="faq-title">Good questions.<br/>Clear answers.</h2><p>Still have something on your mind?<br/>Let’s discuss it during your walkthrough.</p></div><div class="faq-list">{faqs.map(([question,answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  <Closing/>
</Layout>
