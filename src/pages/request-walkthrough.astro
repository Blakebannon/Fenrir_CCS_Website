---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import CommercialOnly from '../components/CommercialOnly.astro';
import { business } from '../config/business';
import { towns, sizes, frequencies, businessTypes, contactMethods } from '../lib/inquiry';
const enabled = business.form.enabled;
---
<Layout title="Request a Walkthrough | Fenrir Commercial Cleaning Service" description="Tell Blake about your workplace in Bailey, Conifer, or Evergreen. Start a conversation about a tailored commercial cleaning scope and schedule.">
  <section class="page-intro request-intro container"><p class="eyebrow">A conversation about your workplace</p><h1>A fresh start,<br/><em>with a clear plan.</em></h1><p class="intro-lead">Tell us a little about your space. We’ll talk through your needs and arrange a walkthrough together.</p><CommercialOnly/></section>
  <div class="request-layout container">
    <form id="walkthrough-form" class="inquiry-form" data-enabled={String(enabled)} action={enabled ? business.form.endpoint : undefined} method="post" novalidate>
      {!enabled && <div class="form-unavailable"><p><strong>Request your walkthrough by phone.</strong></p>{business.phone || business.email ? <p>Contact Blake to discuss your space and arrange a time. {business.phone && <a href={business.phoneHref}>Call {business.phone}</a>} {business.email && <a href={`mailto:${business.email}`}>{business.email}</a>}</p> : <p>If you have Blake’s business card, please use the contact details on it to get in touch.</p>}<p>Online requests are not available yet. Here are the details we’ll discuss when we connect.</p></div>}
      {enabled && <noscript><div class="no-js">Online inquiries need JavaScript to submit securely. {business.phone && <a href={business.phoneHref}>Call Blake</a>} {business.email && <a href={`mailto:${business.email}`}>Email Blake</a>} to discuss your space.</div></noscript>}
      <div id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
      <div id="form-fields">
        <fieldset class="form-section" disabled={!enabled}><legend>First, a few essentials.</legend><p class="field-hint">Required unless marked optional. Provide a phone number or email so Blake can reply.</p><div class="field-grid">
          <div class="field"><label for="contactName">Contact name</label><input id="contactName" name="contactName" autocomplete="name" maxlength="150" required aria-describedby="contactName-error"/><span id="contactName-error" class="field-error"></span></div>
          <div class="field"><label for="businessName">Business name</label><input id="businessName" name="businessName" autocomplete="organization" maxlength="150" required aria-describedby="businessName-error"/><span id="businessName-error" class="field-error"></span></div>
          <div class="field full"><label for="town">Town</label><select id="town" name="town" autocomplete="address-level2" required aria-describedby="town-error"><option value="">Choose your town</option>{towns.map(town => <option>{town}</option>)}</select><span id="town-error" class="field-error"></span></div>
          <div class="field"><label for="phone">Phone <span class="optional">Phone or email required</span></label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="150" aria-describedby="phone-error"/><span id="phone-error" class="field-error"></span></div>
          <div class="field"><label for="email">Email <span class="optional">Phone or email required</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="150" aria-describedby="email-error"/><span id="email-error" class="field-error"></span></div>
        </div></fieldset>
        <hr class="form-divider"/>
        <fieldset class="form-section" disabled={!enabled}><legend>A little about your space.</legend><p class="field-hint">These details are optional. It’s fine if you’re still figuring things out.</p><div class="field-grid">
          <div class="field full"><label for="businessAddress">Business address <span class="optional">Optional</span></label><input id="businessAddress" name="businessAddress" autocomplete="street-address" maxlength="300" aria-describedby="businessAddress-error"/><span id="businessAddress-error" class="field-error"></span></div>
          <div class="field full"><label for="businessType">Business type <span class="optional">Optional</span></label><select id="businessType" name="businessType" aria-describedby="businessType-error"><option value="">Select a type</option>{businessTypes.map(type => <option>{type}</option>)}</select><span id="businessType-error" class="field-error"></span></div>
          <div class="field"><label for="squareFootage">Approximate square footage <span class="optional">Optional</span></label><select id="squareFootage" name="squareFootage" aria-describedby="squareFootage-error">{sizes.map(size => <option>{size}</option>)}</select><span id="squareFootage-error" class="field-error"></span></div>
          <div class="field"><label for="frequency">Desired cleaning frequency <span class="optional">Optional</span></label><select id="frequency" name="frequency" aria-describedby="frequency-error">{frequencies.map(frequency => <option>{frequency}</option>)}</select><span id="frequency-error" class="field-error"></span></div>
          <div class="field full"><label for="preferredContact">Preferred contact method <span class="optional">Optional</span></label><select id="preferredContact" name="preferredContact" aria-describedby="preferredContact-error">{contactMethods.map(method => <option>{method}</option>)}</select><span id="preferredContact-error" class="field-error"></span></div>
          <div class="field full"><label for="message">Your space and needs <span class="optional">Optional</span></label><textarea id="message" name="message" rows="4" maxlength="2000" aria-describedby="message-hint message-error"></textarea><span class="field-hint" id="message-hint">A short description is plenty. Please leave out keys, alarm codes, payment details, and sensitive building information.</span><span id="message-error" class="field-error"></span></div>
        </div></fieldset>
        <div class="honey-field" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div>
        {enabled && <div class="turnstile-wrapper"><div class="cf-turnstile" data-sitekey={business.form.turnstileSiteKey} data-action="request_walkthrough" data-theme="light" data-size="flexible"></div></div>}
        <p class="privacy-note">We’ll use your details to respond to this inquiry and discuss your cleaning needs. No marketing signup. <a href="/privacy">Read our privacy information.</a></p>
        <button class="button form-submit" type="submit" disabled>Send Walkthrough Request <Arrow/></button>
        <p class="form-note">A request starts a conversation. Your walkthrough time is agreed directly with Blake.</p>
      </div>
    </form>
    <aside class="form-sidebar" aria-labelledby="next-title"><p class="eyebrow">What happens next</p><h2 id="next-title">Thoughtful from<br/>the first step.</h2><ol><li>You and Blake discuss your workplace and arrange a suitable walkthrough time.</li><li>You look at the space together and talk through priorities, frequency, and access.</li><li>You receive a written scope and quote to review before work begins.</li></ol><p class="sidebar-note">Recurring cleaning generally runs one to three visits per week. Pricing is per visit, based on the walkthrough, cleanable square footage, frequency, current condition, and agreed scope.</p><div class="sidebar-towns"><p class="eyebrow">Serving our mountain communities</p><p>Bailey · Conifer · Evergreen</p></div>{(business.phone || business.email) && <div class="direct-contact">{business.phone && <a class="text-link" href={business.phoneHref}>Call {business.phone}</a>}{business.email && <a href={`mailto:${business.email}`}>{business.email}</a>}</div>}</aside>
  </div>
  {enabled && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    import '../scripts/walkthrough';
  </script>
</Layout>
