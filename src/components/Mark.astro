---
interface Props { small?: boolean }
import { logoPaths, logoViewBox } from '../config/brand';
const { small = false } = Astro.props;
---
<svg class:list={['brand-mark', { small }]} viewBox={logoViewBox} fill="currentColor" aria-hidden="true">
  {logoPaths.map(d => <path d={d} fill-rule="evenodd"/>)}
</svg>
